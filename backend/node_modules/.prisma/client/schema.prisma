generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  BUYER
  ADMIN
}

enum ExportMode {
  CONSYNAIR_MANAGED
  SELF_MANAGED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FARMER)
  phone        String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farmerProfile FarmerProfile?
  listings      Listing[]
  buyerOrders   Order[]        @relation("OrderBuyer")
  farmerOrders  Order[]        @relation("OrderFarmer")
}

model FarmerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  farmName       String
  county         String
  hasExportDocs  Boolean  @default(false)
  certifications String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Listing {
  id            String        @id @default(cuid())
  farmerId      String
  title         String
  category      String?
  quantity      Float
  unit          String
  pricePerUnit  Float
  currency      String        @default("USD")
  county        String?
  availableFrom DateTime?
  exportMode    ExportMode    @default(CONSYNAIR_MANAGED)
  status        ListingStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  farmer   User               @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orders   Order[]
  syncLogs WordPressSyncLog[]
}

model Order {
  id           String      @id @default(cuid())
  listingId    String
  buyerId      String
  farmerId     String
  requestedQty Float
  unit         String
  offerPrice   Float
  currency     String      @default("USD")
  exportPath   ExportMode  @default(CONSYNAIR_MANAGED)
  serviceFee   Float       @default(0)
  status       OrderStatus @default(REQUESTED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  listing   Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User            @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  farmer    User            @relation("OrderFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  documents OrderDocument[]
}

model OrderDocument {
  id         String   @id @default(cuid())
  orderId    String
  docType    String
  docUrl     String
  providedBy String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WordPressSyncLog {
  id           String   @id @default(cuid())
  listingId    String
  wpPostId     String?
  syncStatus   String
  errorMessage String?
  createdAt    DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
